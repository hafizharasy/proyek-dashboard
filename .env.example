# Salin file ini jadi ".env" lalu isi dengan connection string Supabase Anda.
# Cara dapat connection string: Supabase Dashboard -> Project Settings ->
# Database -> Connection string -> pilih "URI" (mode "Transaction" / pooler
# disarankan untuk aplikasi web).
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@db.xxxxxxxxxxxx.supabase.co:5432/postgres
